# 影库 instance secrets — copied to ~/.config/mediahub/secrets.env (chmod 600) by `scripts/instance.sh init`.
# Never commit; never paste into chats or issues.

# Encrypts the IPA that CI builds with your APP_* values, so the public repo only ever holds an
# encrypted artifact (your hosts are inside the binary). `instance.sh init` generates it;
# `instance.sh ci` stores the same value as the IPA_PASSPHRASE GitHub secret.
IPA_PASSPHRASE=

# Optional, only if you don't use the *_CMD settings in instance.env:
MEDIAHUB_ADMIN_TOKEN=     # ADMIN_TOKEN from the server's /opt/mediahub/.env (scripts/ota.sh)
PUBLISH_TOKEN=            # software-source publisher token (scripts/publish.sh)
