# 影库 instance config — everything that differs between deployments lives here, not in the repo.
#
#   ./scripts/instance.sh init     copies this file to ~/.config/mediahub/instance.env (+ secrets.env)
#   ./scripts/instance.sh check    validates it; ./scripts/instance.sh ci pushes the CI part to GitHub
#
# The directory can be moved with MEDIAHUB_CONFIG_DIR. Keep it out of this repo (back it up in a
# private repo or password manager). Tokens never go here: see secrets.env, or better, read them
# on the server with the *_CMD settings so they never leave it.

# ── App (baked into the IPA and every OTA bundle; also pushed to GitHub secrets by `instance.sh ci`)
APP_BUNDLE_ID=com.example.mediahub          # your own reverse-DNS id
APP_SERVER=https://media.example.com        # backend base URL (OTA manifest = $APP_SERVER/updates/manifest)
APP_EMBY_SERVER=https://emby.example.com:8920  # default Emby address shown on first login

# ── CI (GitHub Actions on your fork)
GH_REPO=                                    # owner/name of the repo that builds your IPA; empty = origin
BUILD_NUMBER_BASE=0                         # CFBundleVersion = base + run number; raise it to stay above old builds
# Extra literal words to mask in CI logs, space-separated (hosts from APP_* are masked automatically).
MASK_TERMS=

# ── Backend deploy (server/deploy/deploy.sh)
DEPLOY_HOST=root@your-server                # ssh target; an ~/.ssh/config alias is fine
# Overrides: put your own mediahub.service / nginx-media.conf in ~/.config/mediahub/deploy/ and deploy.sh
# uses them instead of the repo templates, so you never edit tracked files.

# ── OTA (scripts/ota.sh). Admin token: MEDIAHUB_ADMIN_TOKEN in secrets.env, or read over ssh:
ADMIN_TOKEN_CMD="grep '^ADMIN_TOKEN=' /opt/mediahub/.env | cut -d= -f2-"   # run on $DEPLOY_HOST

# ── 全能签 software source (scripts/publish.sh)
SOURCE_JSON_URL=https://apps.example.com/appstore.json   # checked after publishing
PUBLISH_URL=https://apps.example.com/admin/publish       # multipart endpoint (see docs/DEPLOY_PROMPT.md)
# Either PUBLISH_TOKEN in secrets.env (publisher reachable from here), or run the call on the
# publisher's host so the token stays there:
PUBLISH_SSH_HOST=                           # e.g. root@apps-host; then PUBLISH_URL is as seen from that host
PUBLISH_TOKEN_CMD=                          # command run on PUBLISH_SSH_HOST that prints the token
