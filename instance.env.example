# 影库 instance config — everything that differs between deployments lives here, not in the repo.
#
#   ./scripts/instance.sh init     copies this file to ~/.config/mediahub/instance.env (+ secrets.env)
#   ./scripts/instance.sh check    validates it; ./scripts/instance.sh ci pushes the CI part to GitHub
#
# The directory can be moved with MEDIAHUB_CONFIG_DIR. Keep it out of this repo (back it up in a
# private repo or password manager). Tokens never go here: see secrets.env, or better, read them
# on the server with the *_CMD settings so they never leave it.

# ── App (baked into the IPA and every OTA bundle; also pushed to GitHub secrets by `instance.sh ci`)
APP_BUNDLE_ID=com.example.mediahub          # your own reverse-DNS id
APP_SERVER=https://media.example.com        # backend base URL (OTA manifest = $APP_SERVER/updates/manifest)
APP_EMBY_SERVER=https://emby.example.com:8920  # default Emby address shown on first login

# ── CI (GitHub Actions on your fork)
GH_REPO=                                    # owner/name of the repo that builds your IPA (your fork); empty = origin
BUILD_NUMBER_BASE=0                         # CFBundleVersion = base + run number; raise it to stay above old builds
IOS_RUNNER=                                 # runner label with Xcode 27; empty = the workflow default (xcode-27)
# UPSTREAM_URL=                             # project you forked from; default = the original repo (see instance.sh)
# Extra literal words to mask in CI logs, space-separated (hosts from APP_* are masked automatically).
MASK_TERMS=

# ── Backend deploy (server/deploy/deploy.sh)
DEPLOY_HOST=root@your-server                # ssh target; an ~/.ssh/config alias is fine
NGINX_SITE_PATH=                            # default /etc/nginx/conf.d/media.conf; "none" = you manage the proxy
# Overrides: put your own mediahub.service / nginx-media.conf in ~/.config/mediahub/deploy/ and deploy.sh
# uses them instead of the repo templates, so you never edit tracked files.

# ── OTA (scripts/ota.sh). Admin token: MEDIAHUB_ADMIN_TOKEN in secrets.env, or read over ssh:
ADMIN_TOKEN_CMD="grep '^ADMIN_TOKEN=' /opt/mediahub/.env | cut -d= -f2-"   # run on $DEPLOY_HOST

# ── Operations (.claude/skills/mediahub-ops, scripts run on $DEPLOY_HOST; tokens never leave that host)
APP_TOKEN_CMD="grep '^APP_TOKEN=' /opt/mediahub/.env | cut -d= -f2-"       # backend /v1 token
MP_API_KEY_CMD="grep '^MP_API_KEY=' /opt/mediahub/.env | cut -d= -f2-"     # MoviePilot API key (plugin /hub/*)
MP_URL=http://127.0.0.1:3000                # MoviePilot as seen from $DEPLOY_HOST
SERVER_LOCAL_URL=http://127.0.0.1:8793      # the backend as seen from $DEPLOY_HOST

# ── Software source for 全能签 / AltStore-style installers (scripts/publish.sh). Pick ONE mode;
#    or skip all of it and use `./scripts/publish.sh X.Y.Z --out <dir>` to just get the IPA.
#  static: publish.sh copies the IPA + icon into a directory your web server serves and updates
#          appstore.json there itself. Nothing else to run. Add the source URL in 全能签 once.
PUBLISH_DIR=                                # e.g. /var/www/apps (on PUBLISH_SSH_HOST, or this machine if that is empty)
SOURCE_BASE_URL=                            # public URL of PUBLISH_DIR, e.g. https://apps.example.com
# SOURCE_NAME=影库                          # source title shown in the installer (first publish only)
# SOURCE_JSON_NAME=appstore.json
#  api:    POST to a publisher service you already run (fields: ipa icon bundleId version build name minIos notes force).
PUBLISH_URL=                                # e.g. https://apps.example.com/admin/publish
# Token: PUBLISH_TOKEN in secrets.env (publisher reachable from here), or run the call on the
# publisher's host so the token stays there (PUBLISH_URL is then as seen from that host):
PUBLISH_TOKEN_CMD=                          # command run on PUBLISH_SSH_HOST that prints the token
#  both modes:
PUBLISH_SSH_HOST=                           # ssh target holding PUBLISH_DIR / running the publisher
SOURCE_JSON_URL=                            # checked after publishing; static default = $SOURCE_BASE_URL/appstore.json
# PUBLISH_MODE=                             # static | api; empty = static if PUBLISH_DIR is set, else api
