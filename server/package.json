{
  "name": "mediahub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "影库 backend: one authenticated API over MoviePilot + the Prowlarr115 plugin (search, ingest, 115/qB/OpenList/Emby status), image cache, Expo Updates",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "MP_API_KEY=test APP_TOKEN=test ADMIN_TOKEN=test node --test --experimental-strip-types --no-warnings \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.0.0",
    "opencc-js": "^1.4.2",
    "undici": "^7.30.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
