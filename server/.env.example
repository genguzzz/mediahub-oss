# Copy to .env (never commit). Loaded by the systemd unit / docker run.
APP_TOKEN=            # openssl rand -hex 24  — the token the app enters in Settings
ADMIN_TOKEN=          # openssl rand -hex 24  — used by scripts/ota.sh and /admin/*
MP_API_KEY=           # MoviePilot API token (Settings → Advanced → API token)
MP_URL=http://127.0.0.1:3000/api/v1
EMBY_URL=https://emby.example.com:8920
EMBY_USER=
EMBY_PASS=
UPDATES_BASE=https://media.example.com/updates
DATA_DIR=/opt/mediahub/data
CACHE_DIR=/opt/mediahub/cache
UPDATES_DIR=/opt/mediahub/updates
# Optional: exit per outside source (server/src/egress.ts): direct, http(s)://… or socks5://user:pass@host:port.
# Sources: javdb, jable, hanime, hanime1, tmdb, douban, bangumi. Unlisted = direct; javdb falls back to INDEX_PROXY.
# hanime1 (里番 index + direct MP4 playback) refuses datacenter addresses: it is offered only with an exit set.
# Example: SOURCE_PROXY=javdb=http://127.0.0.1:10809;hanime=socks5://user:pass@host:1080
SOURCE_PROXY=
INDEX_PROXY=
# Jable passes Cloudflare through FlareSolverr (its own network; the clearance is then reused over IPv4)
FLARESOLVERR_URL=http://127.0.0.1:8191/v1
