[Unit]
Description=影库 (mediahub) backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/mediahub/app
EnvironmentFile=/opt/mediahub/.env
Environment=NODE_ENV=production
# /usr/bin/env finds node in /usr/local/bin or /usr/bin (nvm users: put the absolute path in your override)
ExecStart=/usr/bin/env node src/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
